  }
  for (const s of ["SIGINT", "SIGTERM"]) process.on(s, () => process.exit(0));
  log(`t3listen started${DRY ? " (dry run: payloads are printed, nothing is sent)" : ""}; machine "${C.machine}", approvals ${C.approvals ? "on" : "off"}`);
  if (ONCE) { const t0 = Date.now(), limit = (+(optv("--timeout")) || 600) * 1000; setInterval(() => { if (delivered > 0) process.exit(0); if (Date.now() - t0 > limit) { log("--once: nothing happened before the timeout"); process.exit(2); } }, 500); }
  let delay = 2000, warned = "";
  for (;;) {
    const ep = endpoint();
    if (!ep) { if (warned !== "nort") log("T3 Code isn't running here; waiting for it"); warned = "nort"; await sleep(30000); continue; }
    if (!ep.token) die("NO_TOKEN", "no `token` file next to t3listen. Ask T3 Tots to issue one first.");
    const ok = await connect(ep);
    if (ok) { delay = 2000; warned = ""; }
    else {
      try { const r = await fetch(`${ep.base}/api/orchestration/threads/t3listen-auth-check`, { headers: ep.H, signal: AbortSignal.timeout(5000) }); if (r.status === 401 || r.status === 403) { if (warned !== "tok") log("TOKEN_REJECTED: the T3 Tots token expired or was revoked; ask T3 Tots to reissue it"); warned = "tok"; delay = 300000; } }
      catch { if (warned !== "down") log(`can't reach T3 at ${ep.base}; retrying`); warned = "down"; }
    }
