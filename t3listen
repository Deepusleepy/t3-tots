}

// ---------- login autostart ----------
const sh = (c, a, o = {}) => cp.execFileSync(c, a, { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"], ...o });
const tryRun = (c, a) => { try { return { ok: true, out: sh(c, a) }; } catch (e) { return { ok: false, out: String(e.stdout || "") + String(e.stderr || e.message) }; } };
const SELF = path.join(DIR, "t3listen"), extra = argv.filter((a) => a === "--dry-run" || a === "--approvals");
const xml = (s) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const plistPath = () => path.join(HOME, "Library", "LaunchAgents", `${LABEL}.plist`), unitName = () => `${LABEL.replace(/^com\./, "").replace(/\./g, "-")}.service`;
const unitPath = () => path.join(process.env.XDG_CONFIG_HOME || path.join(HOME, ".config"), "systemd", "user", unitName());
const startupLnk = () => path.join(process.env.APPDATA || "", "Microsoft", "Windows", "Start Menu", "Programs", "Startup", `${TASK}.lnk`);
function ps(script) { return sh("powershell.exe", ["-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-Command", script]); }
const psq = (s) => `'${String(s).replace(/'/g, "''")}'`;
function winProcs() { // node processes running THIS t3listen (never touches other node processes)
  try { return ps(`Get-CimInstance Win32_Process -Filter "Name='node.exe'" | Where-Object { $_.CommandLine -like ${psq("*" + SELF + "*")} -and $_.CommandLine -like '* run*' } | ForEach-Object { $_.ProcessId }`).split(/\s+/).filter(Boolean).map(Number); } catch { return []; }
}
function install() {
  if (!fs.existsSync(CONF) && !extra.includes("--dry-run")) die("NO_LISTEN_CONFIG", `run setup first: node "${SELF}" setup`);
  const node = process.execPath, args = [SELF, "run", "--log", ...extra];
  if (process.platform === "darwin") {
    const env = ["T3_HOME", "T3CODE_HOME"].filter((k) => process.env[k]).map((k) => `<key>${k}</key><string>${xml(process.env[k])}</string>`).join("");
    const plist = `<?xml version="1.0" encoding="UTF-8"?>\n<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">\n<plist version="1.0"><dict>\n<key>Label</key><string>${LABEL}</string>\n<key>ProgramArguments</key><array>${[node, ...args].map((a) => `<string>${xml(a)}</string>`).join("")}</array>\n<key>WorkingDirectory</key><string>${xml(DIR)}</string>\n<key>RunAtLoad</key><true/>\n<key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>\n<key>ThrottleInterval</key><integer>30</integer>\n<key>ProcessType</key><string>Background</string>\n<key>StandardErrorPath</key><string>${xml(path.join(DIR, "listen.err.log"))}</string>\n${env ? `<key>EnvironmentVariables</key><dict>${env}</dict>\n` : ""}</dict></plist>\n`;
