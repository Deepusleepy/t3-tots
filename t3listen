#!/usr/bin/env node
// t3listen - tells T3 Tots the moment a T3 Code thread asks a question (and when it's answered or closed),
// by POSTing JSON to the webhook in listen.json. No polling: it follows T3's live event stream. Needs Node 22+.
// The webhook URL and headers live only in listen.json next to this script and are never printed.
const fs = require("fs"), path = require("path"), os = require("os"), crypto = require("crypto"), cp = require("child_process");
const HOME = os.homedir(), DIR = __dirname, CONF = path.join(DIR, "listen.json"), STATE = path.join(DIR, "listen-state.json"), LOG = path.join(DIR, "listen.log"), PID = path.join(DIR, "listen.pid");
const LABEL = process.env.T3LISTEN_LABEL || "com.t3tots.listen", TASK = process.env.T3LISTEN_LABEL || "T3 Tots listener";
const argv = process.argv.slice(2), cmd = argv[0] && !argv[0].startsWith("--") ? argv[0] : "run", flag = (f) => argv.includes(f);
const optv = (f) => { const i = argv.indexOf(f); return i >= 0 && argv[i + 1] && !argv[i + 1].startsWith("--") ? argv[i + 1] : undefined; };
const DRY = flag("--dry-run"), ONCE = flag("--once"), TOLOG = flag("--log"), VERBOSE = flag("--verbose");
function log(...a) {
  const line = `${new Date().toISOString()} ${a.join(" ")}`;
  if (!TOLOG) return console.log(line);
  try { if (fs.existsSync(LOG) && fs.statSync(LOG).size > 1e6) fs.renameSync(LOG, LOG + ".1"); fs.appendFileSync(LOG, line + "\n"); } catch {}
}
const die = (code, msg) => { console.error(`${code}: ${msg}`); process.exit(1); };
const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
const readJSON = (f, d) => { try { return JSON.parse(fs.readFileSync(f, "utf8")); } catch { return d; } };

// ---------- config ----------
function loadConfig() {
  const c = readJSON(CONF, null);
  if (!c) { if (DRY) return { machine: os.hostname().replace(/\.local$/, ""), approvals: flag("--approvals"), skipStaleMinutes: +(optv("--skip-stale") ?? 0) };
    die("NO_LISTEN_CONFIG", `no listen.json next to t3listen. Create it with: node "${path.join(DIR, "t3listen")}" setup  (or use --dry-run)`); }
  if (!DRY && !/^https:\/\//.test(c.url || "") && !/^http:\/\/(127\.0\.0\.1|localhost)[:/]/.test(c.url || "")) die("BAD_LISTEN_CONFIG", "listen.json url must start with https:// (http only for localhost)");
  return { url: c.url, headers: c.headers || {}, machine: c.machine || os.hostname().replace(/\.local$/, ""), approvals: c.approvals === true || flag("--approvals"),
    skipStaleMinutes: Number.isFinite(+c.skipStaleMinutes) ? +c.skipStaleMinutes : 0 };
}
function lockDown(f) {
  if (process.platform !== "win32") { fs.chmodSync(f, 0o600); return; }
  try { cp.execFileSync("icacls", [f, "/inheritance:r", "/grant:r", `${process.env.USERNAME}:F`], { stdio: "ignore" }); } catch { console.error("note: couldn't restrict listen.json permissions (icacls)"); }
}
async function setup() { // stdin: line 1 = webhook URL, then "Header-Name: value" lines (stops after an Authorization line, or at a blank line)
  const lines = [], rl = require("readline").createInterface({ input: process.stdin, output: process.stdin.isTTY ? process.stderr : undefined, terminal: !!process.stdin.isTTY });
  if (process.stdin.isTTY) process.stderr.write("T3 Tots listener setup: paste two lines from the routine panel, pressing Enter after each.\n  Line 1: Webhook URL starting https://\n  Line 2: Authorization header starting Authorization:\n");
  for await (const l of rl) {
    const t = l.trim().replace(/^POST\s+/i, ""); if (!t) { if (lines.length) break; else continue; }
    lines.push(t); if (lines.length > 1 && /^authorization:/i.test(t)) break;
    if (process.stdin.isTTY && lines.length === 1) process.stderr.write(/^https?:\/\//.test(t) ? "  got the URL. Now line 2 (Authorization: ...):\n" : "  that doesn't start with https:// - run setup again and paste the Webhook URL first.\n");
  }
  rl.close();
  const url = lines.shift() || ""; if (!/^https:\/\//.test(url) && !/^http:\/\/(127\.0\.0\.1|localhost)[:/]/.test(url)) die("BAD_URL", "the first line must be the webhook URL (https://...)");
  const headers = {}; for (const l of lines) { const m = l.match(/^([A-Za-z0-9-]+):\s*(.+)$/); if (!m) die("BAD_HEADER", "header lines must look like 'Name: value'"); headers[m[1]] = m[2]; }
  const old = readJSON(CONF, {}), c = { ...old, url, headers, machine: optv("--machine") || old.machine || os.hostname().replace(/\.local$/, ""), approvals: old.approvals === true, skipStaleMinutes: old.skipStaleMinutes ?? 1440 };
  const tmp = CONF + ".part"; fs.writeFileSync(tmp, JSON.stringify(c, null, 1) + "\n", { mode: 0o600 }); fs.renameSync(tmp, CONF); lockDown(CONF);
  console.log(`saved listen.json (url set, ${Object.keys(headers).length} header(s), machine "${c.machine}", approvals ${c.approvals ? "on" : "off"}). Test it with: node "${path.join(DIR, "t3listen")}" test`);
}

// ---------- T3 connection (same discovery as t3ctl) ----------
function t3Dir() {
  for (let v of [process.env.T3_HOME, process.env.T3CODE_HOME]) {
    v = (v || "").trim(); if (!v) continue; if (v.startsWith("~")) v = path.join(HOME, v.slice(1));
    return fs.existsSync(path.join(v, "server-runtime.json")) || fs.existsSync(path.join(v, "statev2.sqlite")) ? v : path.join(v, "userdata");
  }
  const base = path.join(HOME, ".t3");
  return ["userdata", "dev"].map((d) => path.join(base, d)).find((d) => fs.existsSync(path.join(d, "server-runtime.json"))) || path.join(base, "userdata");
}
function endpoint() {
  const rt = readJSON(path.join(t3Dir(), "server-runtime.json"), null); if (!rt) return null;
  const h = rt.host; const base = `http://${!h || h === "0.0.0.0" || h === "::" ? "127.0.0.1" : h.includes(":") ? `[${h}]` : h}:${rt.port}`;
  let token = ""; try { token = fs.readFileSync(path.join(DIR, "token"), "utf8").trim(); } catch {}
  return { base, H: { Authorization: "Bearer " + token, "x-t3-orchestration-protocol": "2" }, token };
}
async function threadSnap(ep, id) {
  const r = await fetch(`${ep.base}/api/orchestration/threads/${encodeURIComponent(id)}`, { headers: ep.H });
  if (r.status === 404) return null; if (!r.ok) throw new Error(`thread fetch HTTP ${r.status}`); return (await r.json()).projection;
}

// ---------- request details (same shape as `t3ctl pending --json`) ----------
const SKIP_KINDS = new Set(["dynamic_tool_call", "auth_refresh"]);
function requestInfo(p, r) {
  const it = (p.turnItems || []).find((i) => i.requestId === r.id && (i.type === "user_input_request" || i.type === "approval_request"));
  const o = { requestId: r.id, kind: r.kind, createdAt: r.createdAt, answerable: (r.responseCapability || {}).type !== "not_resumable" };
  if (r.kind === "user_input") o.questions = ((it && it.questions) || []).map((q) => ({ id: q.id, header: q.header, question: q.question,
    options: (q.options || []).map((x) => ({ label: x.label, description: x.description, ...(x.value !== undefined ? { value: x.value } : {}) })), multiSelect: !!q.multiSelect, allowCustomAnswer: q.allowCustomAnswer !== false, required: q.required !== false }));
  else o.approval = { requestKind: (it && it.requestKind) || r.kind, prompt: (it && it.prompt) || null, appName: (it && it.appName) || null,
    options: (it && it.options && it.options.length ? it.options : [{ decision: "accept", label: "Allow" }, { decision: "decline", label: "Deny" }]).map((x) => ({ decision: x.decision, label: x.label, ...(x.warning ? { warning: x.warning } : {}) })) };
  return o;
}
function summary(e) {
  const where = `"${e.title}"${e.project ? ` (${e.project})` : ""} on ${e.machine}`;
  if (e.event === "request.resolved") return `T3 ${e.kind === "user_input" ? "question" : "approval"} in ${where} is closed: ${e.status}${e.answers ? " - " + Object.values(e.answers).map((v) => (Array.isArray(v) ? v.join(", ") : v)).join("; ") : e.decision ? " - " + e.decision : ""}`;
  if (e.questions) return `T3 question in ${where}:\n` + e.questions.map((q) => `${q.question}${q.multiSelect ? " (pick one or more)" : ""}\n` + q.options.map((x, i) => `  ${i + 1}. ${x.label}`).join("\n") + (q.allowCustomAnswer ? "\n  (or type an answer)" : "")).join("\n");
  return `T3 approval in ${where}: ${e.approval.requestKind}${e.approval.prompt ? " - " + e.approval.prompt : ""}\n` + e.approval.options.map((x) => `  - ${x.label}`).join("\n");
}

// ---------- delivery ----------
let C, queue = [], delivered = 0;
const RETRYABLE = (st, body = "") => st === 408 || st === 429 || st >= 500 || /rate.?limit|too many|try again/i.test(body); // some webhook hosts send rate limits as 400
function redact(s) { // never let the webhook URL or header values reach the log
  s = String(s || ""); const secrets = [C && C.url, ...Object.values((C && C.headers) || {}).flatMap((v) => [v, ...String(v).split(/\s+/)])].filter((v) => v && String(v).length > 7);
  for (const v of secrets.sort((a, b) => String(b).length - String(a).length)) s = s.split(String(v)).join("[redacted]");
  return s.replace(/\s+/g, " ").trim().slice(0, 500);
}
async function post(e) { // one attempt; returns { ok, status, body, retry }
  try {
    const r = await fetch(C.url, { method: "POST", headers: { "content-type": "application/json", "user-agent": "t3listen", ...C.headers }, body: JSON.stringify(e), signal: AbortSignal.timeout(20000) });
    if (r.ok) return { ok: true, status: r.status };
    let body = ""; try { body = await r.text(); } catch {}
    return { ok: false, status: r.status, body: redact(body), retry: RETRYABLE(r.status, body) };
  } catch (err) { return { ok: false, status: 0, body: (err.cause && err.cause.code) || err.name, retry: true }; }
}
function markDelivered(e) { if (e.event === "request.opened" && S.sent[e.requestId]) { S.sent[e.requestId].delivered = true; saveState(); } }
async function deliver(e) {
  e.text = summary(e); e.sentAt = new Date().toISOString(); e.eventId = crypto.createHash("sha256").update(`${e.event}|${e.requestId}`).digest("hex").slice(0, 16);
  if (DRY) { log("DRY-RUN payload " + JSON.stringify(e)); delivered++; return true; }
  for (let i = 0; i < 3; i++) {
    const r = await post(e);
    if (r.ok) { log(`sent ${e.event} "${e.title}" ${e.requestId.slice(-12)} -> HTTP ${r.status}`); delivered++; markDelivered(e); return true; }
    if (r.status) log(`webhook answered HTTP ${r.status} for ${e.event} ${e.requestId.slice(-12)}${r.status === 401 || r.status === 403 ? " (check the key in listen.json)" : ""}${r.body ? `: ${r.body}` : ""}`);
    else log(`webhook not reachable (${r.body})`);
    if (!r.retry) break; if (i < 2) await sleep((/rate.?limit/i.test(r.body || "") ? 20000 : 2000) * 3 ** i);
  }
  // keep it queued and retry every 60s: retryable failures (network, 408, 429, 5xx) for up to 24h, other 4xx 10 times
  if (queue.length < 100) queue.push({ e, rounds: 0, since: Date.now() }); return false;
}
setInterval(async () => {
  if (!queue.length) return; const q = queue; queue = [];
  for (const item of q) {
    const { e } = item; item.rounds++; e.sentAt = new Date().toISOString();
    const r = await post(e);
    if (r.ok) { log(`sent ${e.event} "${e.title}" ${e.requestId.slice(-12)} -> HTTP ${r.status} (retry ${item.rounds})`); delivered++; markDelivered(e); continue; }
    log(`retry ${item.rounds}: ${r.status ? `webhook answered HTTP ${r.status}` : `webhook not reachable (${r.body})`} for ${e.event} ${e.requestId.slice(-12)}${r.status && r.body ? `: ${r.body}` : ""}`);
    if (r.retry ? Date.now() - item.since < 864e5 : item.rounds < 10) { if (queue.length < 100) queue.push(item); }
    else log(`giving up on ${e.event} ${e.requestId.slice(-12)} after ${item.rounds} retries; it is tried again when the listener restarts`);
  }
}, 60000).unref();

// ---------- state: which requests the phone has been told about ----------
let S = { sent: {} };
const saveState = () => { if (DRY) return; const t = STATE + ".part"; fs.writeFileSync(t, JSON.stringify(S)); fs.renameSync(t, STATE); };
const known = new Map(); // threadId -> pendingRuntimeRequest.id last seen (null = none)
const meta = { projects: new Map(), threads: new Map() };
const wanted = (r) => r.status === "pending" && !SKIP_KINDS.has(r.kind) && (r.kind === "user_input" || C.approvals) && (r.responseCapability || {}).type !== "not_resumable";

async function reconcile(ep, threadId, opts = {}) {
  const t = meta.threads.get(threadId) || {}; let p = null;
  if (!opts.gone) { try { p = await threadSnap(ep, threadId); } catch (err) { log(`couldn't read thread ${threadId.slice(0, 40)}: ${err.message}`); return; } }
  const base = { machine: C.machine, threadId, title: t.title || threadId, project: meta.projects.get(t.projectId) || null };
  const all = p ? p.runtimeRequests || [] : [];
  const open = all.filter(wanted);
  for (const r of open) {
    if (S.sent[r.id] && (S.sent[r.id].delivered !== false || !opts.startup)) continue;
    const ageMin = (Date.now() - Date.parse(r.createdAt)) / 60000;
    if (opts.startup && C.skipStaleMinutes > 0 && ageMin > C.skipStaleMinutes) { S.sent[r.id] = { threadId, skipped: true }; continue; }
    const e = { event: "request.opened", ...base, ...requestInfo(p, r) };
    if (e.questions && !e.questions.length) e.note = "question details not readable; answer it in T3";
    S.sent[r.id] = { threadId, at: (S.sent[r.id] && S.sent[r.id].at) || Date.now(), delivered: false }; saveState(); await deliver(e);
  }
  for (const [id, s] of Object.entries(S.sent)) {
    if (s.threadId !== threadId || open.some((r) => r.id === id)) continue;
    const r = all.find((x) => x.id === id);
    if (!s.skipped) await deliver({ event: "request.resolved", ...base, requestId: id, kind: r ? r.kind : "user_input", status: opts.gone || (r ? r.status : "gone"),
      ...(r && r.answers ? { answers: r.answers } : {}), ...(r && r.decision ? { decision: r.decision } : {}), resolvedAt: (r && r.resolvedAt) || new Date().toISOString() });
    delete S.sent[id]; saveState();
  }
}

function connect(ep) {
  return new Promise((resolve) => {
    const ws = new WebSocket(`${ep.base.replace("http", "ws")}/ws?orchestrationProtocol=2`, { headers: ep.H });
    let first = true, last = Date.now(), busy = Promise.resolve(); const id = String(Date.now());
    const work = (fn) => { busy = busy.then(fn).catch((err) => log("error:", err.message)); };
    const hb = setInterval(() => { if (Date.now() - last > 75000) { log("T3 stopped answering; reconnecting"); ws.close(); } else try { ws.send(JSON.stringify({ _tag: "Ping" })); } catch {} }, 25000);
    ws.onopen = () => { log(`connected to T3 at ${ep.base}`); ws.send(JSON.stringify({ _tag: "Request", id, tag: "orchestration.subscribeShell", payload: {}, headers: [] })); };
    ws.onmessage = (ev) => {
      last = Date.now(); let msgs; try { msgs = JSON.parse(ev.data); } catch { return; } if (!Array.isArray(msgs)) msgs = [msgs];
      for (const m of msgs) {
        if (m._tag === "Ping") { ws.send(JSON.stringify({ _tag: "Pong" })); continue; }
        if (m._tag === "Exit" || m._tag === "Defect") { log("T3 ended the stream:", JSON.stringify(m.exit || m).slice(0, 300)); ws.close(); continue; }
        if (m._tag !== "Chunk") continue;
        ws.send(JSON.stringify({ _tag: "Ack", requestId: m.requestId }));
        for (const v of m.values || []) work(() => onItem(ep, v, first && v.kind === "snapshot" && (first = false, true)));
      }
    };
    ws.onerror = () => {}; ws.onclose = () => { clearInterval(hb); busy.then(() => resolve(!first)); };
  });
}
async function onItem(ep, v, full) {
  if (v.kind === "snapshot") {
    for (const p of v.snapshot.projects || []) meta.projects.set(p.id, p.title);
    if (!full) return; // later snapshots are project-metadata refreshes with no threads
    const live = new Set();
    for (const t of v.snapshot.threads || []) { live.add(t.id); meta.threads.set(t.id, { title: t.title, projectId: t.projectId }); known.set(t.id, t.pendingRuntimeRequest ? t.pendingRuntimeRequest.id : null); }
    const check = new Set([...v.snapshot.threads.filter((t) => t.pendingRuntimeRequest).map((t) => t.id), ...Object.values(S.sent).map((s) => s.threadId)]);
    for (const tid of check) await reconcile(ep, tid, { startup: true, ...(live.has(tid) ? {} : { gone: "archived-or-deleted" }) });
    log(`watching ${live.size} threads; ${Object.values(S.sent).filter((s) => !s.skipped).length} open question(s) sent, ${Object.values(S.sent).filter((s) => s.skipped).length} older one(s) skipped`);
  } else if (v.kind === "project.updated") meta.projects.set(v.project.id, v.project.title);
  else if (v.kind === "thread.updated") {
    const t = v.thread; meta.threads.set(t.id, { title: t.title, projectId: t.projectId });
    if (v.location === "archive") { if (Object.values(S.sent).some((s) => s.threadId === t.id)) await reconcile(ep, t.id, { gone: "archived" }); known.delete(t.id); return; }
    const now = t.pendingRuntimeRequest ? t.pendingRuntimeRequest.id : null, before = known.has(t.id) ? known.get(t.id) : null; known.set(t.id, now);
    const tracked = Object.values(S.sent).filter((s) => s.threadId === t.id && !s.skipped).length;
    if (VERBOSE && (tracked || now !== before)) log(`thread.updated "${t.title}" pending ${before ? before.slice(-12) : "-"} -> ${now ? now.slice(-12) : "-"} (tracked ${tracked})`);
    if (now !== before || tracked > 1 || (tracked === 1 && !now)) await reconcile(ep, t.id);
  } else if (v.kind === "thread.removed") { known.delete(v.threadId); if (Object.values(S.sent).some((s) => s.threadId === v.threadId)) await reconcile(ep, v.threadId, { gone: "deleted" }); }
}

async function run() {
  C = loadConfig(); if (+process.versions.node.split(".")[0] < 22 || typeof WebSocket === "undefined") die("NODE_TOO_OLD", `t3listen needs Node 22 or newer (found ${process.version})`);
  if (!DRY) {
    const other = +(fs.existsSync(PID) && fs.readFileSync(PID, "utf8")); if (other && other !== process.pid) { try { process.kill(other, 0); die("ALREADY_RUNNING", `another t3listen is running (pid ${other})`); } catch (e) { if (e.code === "EPERM") die("ALREADY_RUNNING", `another t3listen is running (pid ${other})`); } }
    fs.writeFileSync(PID, String(process.pid)); process.on("exit", () => { try { if (+fs.readFileSync(PID, "utf8") === process.pid) fs.unlinkSync(PID); } catch {} });
